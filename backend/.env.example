# 1 só no desenvolvimento; na feira use 0 (sem reloader nem debugger)
FLASK_DEBUG=1
# 127.0.0.1: só este computador; 0.0.0.0: aceita conexões da rede (tablets da feira, exige FLASK_DEBUG=0)
HOST=127.0.0.1
PORT=5000
# auto: usa o Supabase quando SUPABASE_URL e SUPABASE_KEY estiverem definidos; senão, app/data/seed.json
DATA_SOURCE=auto
SUPABASE_URL=
# chave service_role: uso exclusivo do servidor, nunca expor no frontend
SUPABASE_KEY=
# origens do frontend, separadas por vírgula; na rede da feira inclua http://<IP-deste-computador>:3000
CORS_ORIGINS=http://localhost:3000
# cache em memória das leituras do catálogo, em segundos (0 desliga); vencido, é servido e revalidado em segundo plano
CATALOG_CACHE_SECONDS=3600
# 1: se o Supabase falhar, o catálogo é servido do cache e de app/data/seed.json; 0: responde 503
FALLBACK_TO_LOCAL=1
